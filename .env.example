# =================================================================
# Shopify Product Launch Platform - Environment Configuration Template
# =================================================================
# Copy this file to .env and populate with your own credentials:
#   cp .env.example .env
# Never commit the populated .env file to version control.
# =================================================================

# -----------------------------------------------------------------
# 1. Application Settings
# -----------------------------------------------------------------
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=*

# -----------------------------------------------------------------
# 2. Primary Shopify Store Credentials
# -----------------------------------------------------------------
# Domain of your primary Shopify store (e.g., store.myshopify.com)
SHOPIFY_STORE_URL=your-store.myshopify.com

# Shopify Admin API Access Token (starts with shpat_)
SHOPIFY_ACCESS_TOKEN=shpat_your_admin_access_token_here

# Shopify API Version
SHOPIFY_API_VERSION=2025-07

# -----------------------------------------------------------------
# 3. Shopify App OAuth Credentials (Partner App / Embedded Flow)
# -----------------------------------------------------------------
SHOPIFY_CLIENT_ID=your_shopify_client_id_here
SHOPIFY_CLIENT_SECRET=your_shopify_client_secret_here
SHOPIFY_API_SECRET=your_shopify_api_secret_here
SHOPIFY_APP_URL=http://localhost:8000
SHOPIFY_REDIRECT_URI=http://localhost:8000/api/shopify/callback

# -----------------------------------------------------------------
# 4. Multi-Store Audit & Validation Configuration (Optional)
# -----------------------------------------------------------------
# Dev/Staging Store
SHOPIFY_DEV_STORE=your-dev-store.myshopify.com
SHOPIFY_DEV_TOKEN=shpat_your_dev_access_token_here

# Validation Store (used for 53-check catalog audits)
SHOPIFY_VALIDATION_STORE=your-validation-store.myshopify.com
SHOPIFY_VALIDATION_TOKEN=shpat_your_validation_access_token_here

# -----------------------------------------------------------------
# 5. Google AI / Gemini / Vertex AI Configuration
# -----------------------------------------------------------------
# Google API Key for Google ADK agents & Gemini models
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Vertex AI Settings (set GOOGLE_GENAI_USE_VERTEXAI=True if using GCP Vertex)
GOOGLE_GENAI_USE_VERTEXAI=False
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# -----------------------------------------------------------------
# 6. Firebase Service Account & Storage (Optional)
# -----------------------------------------------------------------
FIREBASE_SERVICE_ACCOUNT_KEY=path/to/service-account.json
FIREBASE_STORAGE_BUCKET=your-bucket.appspot.com

# -----------------------------------------------------------------
# 7. Email & Notification Settings (Optional)
# -----------------------------------------------------------------
SALES_TEAM_EMAIL=sales@yourdomain.com
SENDER_EMAIL=notifications@yourdomain.com
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password

# -----------------------------------------------------------------
# 8. Google Sheets Student Registration Automation
# -----------------------------------------------------------------
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id_here
GOOGLE_SHEETS_TAB_NAME=Registrations
GOOGLE_APPLICATION_CREDENTIALS=path/to/google-sheets-service-account.json
MOCK_GOOGLE_SHEETS=False

# -----------------------------------------------------------------
# 9. Google Search Console Configuration (Phase 4)
# -----------------------------------------------------------------
SEARCH_CONSOLE_SITE_URL=https://your-store.myshopify.com
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/seo/search-console/oauth/callback
GSC_SERVICE_ACCOUNT_KEY=path/to/gsc-service-account.json

# -----------------------------------------------------------------
# 10. Frontend Configuration (Optional)
# -----------------------------------------------------------------
# If frontend is hosted on a separate port or reverse-proxied
VITE_API_BASE_URL=
