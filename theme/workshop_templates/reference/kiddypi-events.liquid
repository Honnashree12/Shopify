{% comment %}
  KiddyPi events section
{% endcomment %}

<style>
  #kev-{{ section.id }} {
    --kev-bg: {{ section.settings.background | default: '#F7EEE4' }};
    --kev-ink: {{ section.settings.text_color | default: '#3D2200' }};
    --kev-muted: {{ section.settings.muted_color | default: '#6B4A2E' }};
    --kev-accent: {{ section.settings.accent_color | default: '#E87D1E' }};
    --kev-accent-lt: {{ section.settings.accent_light | default: '#F3922C' }};
    background: var(--kev-bg);
  }
</style>

<div id="kev-{{ section.id }}">
  <div class="kev-inner">
    {% if section.settings.heading != blank %}
      <h1 class="kev-title">{{ section.settings.heading }}</h1>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "KiddyPi events",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Small heading", "default": "KiddyPi events" },
    { "type": "text", "id": "heading", "label": "Page heading", "default": "Workshops & missions" }
  ]
}
{% endschema %}
